# Copy to .env.local for local development, or set these in the Vercel project settings.
# Never commit real values.

# Public base URL (used in evidence-receipt QR codes and invitation links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# PostgreSQL 15+ connection string (Supabase: use the transaction pooler URI, port 6543).
# Leave unset locally to use an embedded PGlite database in .data/pglite.
DATABASE_URL=
DATABASE_POOL_MAX=3

# Optional AI provider for "Ask with Evidence" synthesis (quotes are still validated).
# Without these, answers are extractive quotes and drafts use deterministic templates.
LLM_PROVIDER=anthropic
LLM_API_KEY=
LLM_MODEL=

# Vercel Cron authorisation for /api/cron/outbox (scheduled publication processing)
CRON_SECRET=

# External social posting stays disabled; no platform adapters are implemented.
ALLOW_EXTERNAL_SOCIAL_PUBLISH=false

# Development only: let an author approve their own draft (labelled "not independent"). Ignored in production.
ALLOW_SELF_REVIEW=false
