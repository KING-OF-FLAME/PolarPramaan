{
  "name": "polarpramaan",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "PolarPramaan — evidence-backed polar science repository and outreach platform (SIH26063, independent student project).",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:migrate": "tsx --conditions=react-server scripts/db-migrate.ts",
    "db:test": "vitest run tests/db",
    "ingest:bootstrap": "tsx --conditions=react-server scripts/ingest-bootstrap.ts",
    "data:verify": "tsx --conditions=react-server scripts/data-verify.ts",
    "eval:run": "tsx --conditions=react-server scripts/eval-run.ts",
    "admin:invite": "tsx --conditions=react-server scripts/admin-invite.ts",
    "jobs:run": "tsx --conditions=react-server scripts/jobs-run.ts",
    "snapshot:fetch": "node scripts/snapshot/fetch-sources.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "0.128.0",
    "@electric-sql/pglite": "0.5.8",
    "d3-geo": "3.1.1",
    "jszip": "3.10.2",
    "next": "16.3.6",
    "pdfjs-dist": "6.3.289",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "recharts": "3.10.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/postcss": "4.3.3",
    "@types/d3-geo": "3.1.1",
    "@types/node": "22.20.4",
    "@types/pngjs": "6.0.5",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "jsqr": "1.4.0",
    "pngjs": "7.0.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp",
      "unrs-resolver"
    ]
  }
}
